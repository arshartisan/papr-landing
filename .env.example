# Polar (https://polar.sh) — create these in your Polar dashboard.
# Use a sandbox org + token while testing (https://sandbox.polar.sh).
POLAR_SERVER=sandbox                # sandbox | production
POLAR_ACCESS_TOKEN=polar_oat_xxx    # Settings → Developers → Organization access token
POLAR_PRODUCT_ID=                   # the one-time $5 "Papr" product (with a File Downloads benefit)
POLAR_ORG_ID=                       # Settings → Organization (the slug for re-download links is looked up from it)
